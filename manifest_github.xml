<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
    xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
    xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides/1.0"
    xsi:type="TaskPaneApp">

    <Id>6b5b5c7a-abcd-4f12-a234-999999999999</Id>
    <Version>1.0.0.11</Version>
    <ProviderName>Construction Quality Pro</ProviderName>
    <DefaultLocale>en-US</DefaultLocale>

    <DisplayName DefaultValue="CQ PRO GLOBAL" />
    <Description DefaultValue="Professional Quality Management" />
    <SupportUrl DefaultValue="https://buiquangtrung2012-ops.github.io/HoSoQuanLyChatLuong/" />

    <Hosts>
        <Host Name="Document" />
    </Hosts>

    <Requirements>
        <Sets DefaultMinVersion="1.1">
            <Set Name="WordApi" MinVersion="1.1"/>
        </Sets>
    </Requirements>

    <DefaultSettings>
        <SourceLocation DefaultValue="https://buiquangtrung2012-ops.github.io/HoSoQuanLyChatLuong/index.html" />
    </DefaultSettings>

    <AppDomains>
        <AppDomain>https://buiquangtrung2012-ops.github.io</AppDomain>
    </AppDomains>

    <Permissions>ReadWriteDocument</Permissions>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides/1.0"
                      xsi:type="VersionOverridesV1_0">

        <Requirements>
            <bt:Sets DefaultMinVersion="1.1">
                <bt:Set Name="WordApi" MinVersion="1.1"/>
            </bt:Sets>
        </Requirements>

        <Hosts>
            <Host xsi:type="Document">
                <DesktopFormFactor>
                    <ExtensionPoint xsi:type="PrimaryCommandSurface">
                        <CustomTab id="CQProTabFinal">
                            <Group id="CQProGroupFinal">
                                <Label resid="GroupLabel" />

                                <Control xsi:type="Button" id="CQPro.OpenFinal">
                                    <Label resid="ButtonLabel" />

                                    <Supertip>
                                        <Title resid="ButtonLabel" />
                                        <Description resid="ButtonTooltip" />
                                    </Supertip>

                                    <Icon>
                                        <bt:Image size="16" resid="Icon16" />
                                        <bt:Image size="32" resid="Icon32" />
                                        <bt:Image size="80" resid="Icon80" />
                                    </Icon>

                                    <Action xsi:type="ShowTaskpane">
                                        <TaskpaneId>CQProTPF</TaskpaneId>
                                        <SourceLocation resid="TaskpaneUrl" />
                                    </Action>
                                </Control>
                            </Group>

                            <Label resid="TabLabel" />
                        </CustomTab>
                    </ExtensionPoint>
                </DesktopFormFactor>
            </Host>
        </Hosts>

        <Resources>
            <bt:Urls>
                <bt:Url id="TaskpaneUrl" DefaultValue="https://buiquangtrung2012-ops.github.io/HoSoQuanLyChatLuong/index.html" />
            </bt:Urls>

            <bt:Images>
                <bt:Image id="Icon16" DefaultValue="https://res-1.cdn.office.net/files/fabric-cdn-prod_20230815.002/assets/brand-icons/product/svg/word_16x1.svg" />
                <bt:Image id="Icon32" DefaultValue="https://res-1.cdn.office.net/files/fabric-cdn-prod_20230815.002/assets/brand-icons/product/svg/word_32x1.svg" />
                <bt:Image id="Icon80" DefaultValue="https://res-1.cdn.office.net/files/fabric-cdn-prod_20230815.002/assets/brand-icons/product/svg/word_80x1.svg" />
            </bt:Images>

            <bt:ShortStrings>
                <bt:String id="GroupLabel" DefaultValue="Cong cu" />
                <bt:String id="TabLabel" DefaultValue="CQ PRO" />
                <bt:String id="ButtonLabel" DefaultValue="Mo Sidebar" />
            </bt:ShortStrings>

            <bt:LongStrings>
                <bt:String id="ButtonTooltip" DefaultValue="Mo bang dieu khien quan ly chat luong" />
            </bt:LongStrings>
        </Resources>

    </VersionOverrides>
</OfficeApp>